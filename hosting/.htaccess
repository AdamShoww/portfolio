# Apache settings for the reg.ru hosting. The deploy workflow copies this file
# to the site root; GitHub Pages ignores it.

DirectoryIndex index.html

# No folder listings
Options -Indexes

# Never serve dot files (.htaccess, .git leftovers) or editor backups
<FilesMatch "^\.|~$|\.(bak|old|orig|swp|log)$">
  Require all denied
</FilesMatch>

<IfModule mod_headers.c>
  # The browser must not guess file types. Framing is limited by frame-ancestors 'none'; nothing else may run or load.
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; connect-src 'self'; media-src 'self'; object-src 'none'; frame-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'none'; upgrade-insecure-requests"

  # HTTPS only for six months (Let's Encrypt via Ispmanager)
  Header always set Strict-Transport-Security "max-age=15552000"

  # No version banners
  Header always unset X-Powered-By
</IfModule>
